{
  "name": "enig-term",
  "version": "0.1.0",
  "description": "Browser BBS terminal: icy_engine in WASM, a TypeScript shell, WebGL2 output",
  "license": "BSD-2-Clause",
  "author": "Bryan D. Ashby",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "scripts/build-wasm.sh",
    "build:js": "node scripts/build-js.mjs",
    "build": "npm run build:wasm && npm run build:js",
    "typecheck": "tsc --noEmit",
    "serve": "node scripts/serve.mjs",
    "test:unit": "node --test test/core.test.mjs test/fonts.test.mjs test/shell.test.mjs test/fonts-tools.test.mjs",
    "test:browser": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run test:browser",
    "test:live": "playwright test --project=chromium test/live.spec.ts",
    "setup:webkit": "node scripts/webkit-deps.mjs",
    "fuzz": "node test/fuzz-core.mjs",
    "goldens": "node test/goldens.mjs --write",
    "bench": "ENIG_TERM_BENCH=1 playwright test test/bench.spec.ts && node test/bench-core.mjs",
    "fixtures": "node test/fixtures/make-fixtures.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "fonts:amiga": "node scripts/fetch-amiga-fonts.mjs --out test/amiga-fonts"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
