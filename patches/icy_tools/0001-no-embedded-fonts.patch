+
+// enig-term patch (patches/icy_tools/0001-no-embedded-fonts.patch): no font
+// data is compiled in. These shadow the std macros for the whole crate, so
+// every embedded font (data/fonts, BGI .CHR, SkyPix YAFF) becomes empty data
+// and the host loads fonts at runtime (BitFont::from_bytes).
+macro_rules! include_bytes {
+    ($($t:tt)*) => {
+        (&[] as &'static [u8])
+    };
+}
+macro_rules! include_str {
+    ($($t:tt)*) => {
+        ""
+    };
+}
