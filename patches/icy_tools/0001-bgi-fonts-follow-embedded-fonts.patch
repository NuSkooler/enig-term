 impl Font {
+    /// enig-term patch: a font without characters (the stroke font data is not compiled in).
+    pub fn empty() -> Self {
+        Self {
+            name: String::new(),
+            size: 0,
+            characters: Vec::new(),
+            org_to_cap: 0,
+            org_to_base: 0,
+            org_to_dec: 0,
+            capital_height: 0,
+            base_height: 0,
+            descender_height: 0,
+            lower_case_height: 0,
+        }
+    }
+
     pub fn height(&self) -> i32 {
         self.org_to_cap.abs() as i32 + self.org_to_dec.abs() as i32
     }
